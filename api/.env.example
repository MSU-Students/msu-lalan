# Application
PORT=3001
NODE_ENV=development
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=lalan_user
DB_PASSWORD=lalan_password
DB_DATABASE=msu_lalan_db
DB_SYNCHRONIZE=true
DB_LOGGING=true

# JWT Authentication
JWT_SECRET=your_jwt_super_secret_key_change_in_production_2026
JWT_EXPIRATION=15m
JWT_REFRESH_TTL_SECONDS=2592000

# Google OAuth 2.0 Credentials (obtain from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# Institutional Domain Filter (MSU Main Campus)
ALLOWED_DOMAIN=msumain.edu.ph
